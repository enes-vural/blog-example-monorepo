---
const year = new Date().getFullYear();
const PORTAL_URL = 'http://localhost:3000';
---
<footer class="footer">
  <div class="container">
    <div class="top">
      <div class="brand">
        <a href="/" class="logo">
          <span class="logo-dot"></span>
          DevBlog
        </a>
        <p>Modern geliştirici blogu. Kod, mimari ve teknoloji üzerine.</p>
      </div>

      <div class="links">
        <div class="link-group">
          <h4>Blog</h4>
          <a href={PORTAL_URL}>Yazılar</a>
          <a href={`${PORTAL_URL}/login`}>Giriş Yap</a>
        </div>
        <div class="link-group">
          <h4>Hakkında</h4>
          <a href="#hakkinda">Ne yapıyoruz?</a>
          <a href="#ozellikler">Özellikler</a>
        </div>
      </div>
    </div>

    <div class="bottom">
      <span>{year} &copy; DevBlog. Tüm hakları saklıdır.</span>
      <span class="stack">Astro + Next.js + Laravel</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    padding: 4rem 0 2rem;
  }

  .container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .top {
    display: flex;
    justify-content: space-between;
    gap: 3rem;
    margin-bottom: 3rem;
    flex-wrap: wrap;
  }

  .brand {
    max-width: 280px;
  }

  .logo {
    font-size: 1.1rem;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .logo-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 8px var(--accent);
  }

  .brand p {
    color: var(--text-muted);
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .links {
    display: flex;
    gap: 4rem;
  }

  .link-group {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .link-group h4 {
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    margin-bottom: 0.25rem;
  }

  .link-group a {
    font-size: 0.9rem;
    color: var(--text-muted);
    transition: color 0.2s;
  }

  .link-group a:hover {
    color: var(--text);
  }

  .bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
    font-size: 0.8rem;
    color: var(--text-muted);
    flex-wrap: wrap;
    gap: 1rem;
  }

  .stack {
    font-family: monospace;
    color: var(--accent-light);
    opacity: 0.7;
  }
</style>
